POSTGRES_USER=erecept
POSTGRES_PASSWORD=erecept
POSTGRES_DB=erecept

# Для запуска без Docker (go run ./cmd/app). В docker-compose переопределяется.
DATABASE_URL=postgres://erecept:erecept@localhost:5432/erecept?sslmode=disable

PORT=8080
TZ=Asia/Almaty

# Только для Render: в какие часы сервер сам себя пингует, чтобы не уснуть.
KEEP_AWAKE_HOURS=8-23

# Адрес, который зашивается в QR-код. Пусто = RENDER_EXTERNAL_URL или адрес запроса.
PUBLIC_URL=
# 0 — не загружать тестовые данные (2 врача, 8 аптек, 30 лекарств) в пустую базу.
SEED_DEMO=1

# Ключ Claude API для ИИ-памяток о лекарствах. Пусто — памятки не создаются.
ANTHROPIC_API_KEY=
